# --- required ---
OPENAI_API_KEY=
RAIL_SECRET=replace-with-a-long-random-secret-at-least-24-chars

# --- generation ---
OPENAI_MODEL=gpt-4.1-mini
# Autopilot: create one pending draft every N minutes (0 = off). Never publishes.
DRAFT_INTERVAL_MINUTES=0
MAX_PENDING_DRAFTS=10
# Draft creation is sized to WEEKLY_POST_CAP so the bot never writes more than it can post:
#   per rolling 7 days: WEEKLY_DRAFT_CAP (default = WEEKLY_POST_CAP, i.e. 200)
#   per rolling 24 h:   DAILY_DRAFT_CAP  (default = ceil(weekly / 7), i.e. 29)
# "auto" or empty keeps the derived value; a number overrides it.
DAILY_DRAFT_CAP=auto
WEEKLY_DRAFT_CAP=auto

# --- server ---
HOST=127.0.0.1
PORT=3000
RAIL_DATA_PATH=./data/drafts.json
RATE_LIMIT_PER_MIN=120
DRAFT_LIMIT_PER_HOUR=30
AUTH_FAIL_LIMIT=10
# Where the real client IP comes from behind a proxy, so limits/lockout apply per client:
#   x-real-ip  -> Railway (its edge sets X-Real-IP)
#   1          -> one proxy hop that appends to X-Forwarded-For (nginx, Fly)
#   0          -> no proxy (default); never set this without a proxy, clients could spoof their IP
TRUST_PROXY=0

# --- Buffer (optional) ---
BUFFER_API_KEY=
BUFFER_GRAPHQL_URL=https://api.buffer.com
# Find these with GET /buffer/check and GET /buffer/channels
BUFFER_ORGANIZATION_ID=
BUFFER_CHANNEL_ID=
# Must be exactly "true" to let approved drafts be sent to Buffer (as Buffer drafts, never auto-published)
BUFFER_WRITES_ENABLED=false
# Max posts sent to Buffer per rolling 7 days (0 = block all sends)
WEEKLY_POST_CAP=200
